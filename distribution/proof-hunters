#!/usr/bin/env python3
"""Profile-bound, single-proof launcher. No third-party Python dependencies."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import urllib.request
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parent

def rpc(url, method, params):
    request = urllib.request.Request(url, data=json.dumps({'jsonrpc':'2.0','id':1,'method':method,'params':params}).encode(), headers={'Content-Type':'application/json','User-Agent':'ProofHuntersCLI/0.2.1'})
    with urllib.request.urlopen(request, timeout=20) as response:
        result = json.load(response)
    if 'error' in result or 'result' not in result:
        raise ValueError('RPC request failed: '+method)
    return result['result']

def prepare(args, call=rpc):
    profile = json.loads((ROOT/'profiles'/f'{args.network}.json').read_text())
    if profile.get('network') != args.network or profile.get('ready') is not True:
        raise ValueError('Network release is not cleared: '+profile.get('reason','verification pending'))
    if args.network == 'mainnet' and args.command == 'mine' and not args.confirm_mainnet:
        raise ValueError('Mainnet mining requires --confirm-mainnet and a cleared mainnet profile')
    if type(profile.get('chainId')) is not int or profile['chainId'] <= 0:
        raise ValueError('Invalid chain ID')
    if args.network == 'testnet' and profile['chainId'] != 46630:
        raise ValueError('Testnet profile must use chain 46630')
    if args.network == 'mainnet' and profile['chainId'] != 4663:
        raise ValueError('Mainnet profile must use chain 4663')
    url = urlsplit(profile['rpcUrl'])
    if url.scheme != 'https' or not url.hostname or url.username or url.password or url.query or url.fragment:
        raise ValueError('Profile RPC must use HTTPS without embedded credentials')
    for key in ['miningCore','basket']:
        if not re.fullmatch(r'0x[0-9a-fA-F]{40}',profile[key]) or int(profile[key],16)==0:
            raise ValueError('Invalid '+key)
    for key in ['coreCodeSha256','basketCodeSha256','binarySha256']:
        if not isinstance(profile.get(key),str) or not re.fullmatch(r'[0-9a-f]{64}',profile[key]):
            raise ValueError('Missing release checksum: '+key)
    binary = ROOT/('bproof.exe' if os.name == 'nt' else 'bproof')
    if not binary.is_file() or hashlib.sha256(binary.read_bytes()).hexdigest()!=profile['binarySha256']:
        raise ValueError('CLI binary does not match the cleared release checksum')
    if int(call(profile['rpcUrl'],'eth_chainId',[]),16)!=profile['chainId']:
        raise ValueError('RPC chain mismatch')
    for address, digest in [('miningCore','coreCodeSha256'),('basket','basketCodeSha256')]:
        code=call(profile['rpcUrl'],'eth_getCode',[profile[address],'latest'])
        if not re.fullmatch(r'0x(?:[0-9a-fA-F]{2})+',code) or hashlib.sha256(bytes.fromhex(code[2:])).hexdigest()!=profile[digest]:
            raise ValueError('Contract bytecode mismatch: '+address)
    command=[str(binary),args.command,'--rpc-url',profile['rpcUrl'],'--chain-id',str(profile['chainId']),'--mining-core',profile['miningCore'],'--json']
    if args.command=='mine':
        if not args.keystore or not args.max_fee_wei or not re.fullmatch(r'[1-9][0-9]*',args.max_fee_wei):
            raise ValueError('Mining requires --keystore and a positive --max-fee-wei')
        command += ['--submit','--basket',profile['basket'],'--keystore',args.keystore,'--max-fee',args.max_fee_wei,'--max-attempts',str(args.max_attempts)]
        if args.passphrase_file: command += ['--passphrase-file',args.passphrase_file]
        if args.threads: command += ['--threads',str(args.threads)]
    return command

def positive(value):
    n=int(value)
    if n<1: raise argparse.ArgumentTypeError('must be positive')
    return n

def main():
    parser=argparse.ArgumentParser(description='Proof Hunters release launcher: verified profiles, one proof per mining call.')
    parser.add_argument('--network',choices=['testnet','mainnet'],default='testnet')
    parser.add_argument('command',choices=['profile','status','mine'])
    parser.add_argument('--keystore')
    parser.add_argument('--passphrase-file')
    parser.add_argument('--max-fee-wei')
    parser.add_argument('--max-attempts',type=positive,default=1000000)
    parser.add_argument('--threads',type=positive)
    parser.add_argument('--confirm-mainnet',action='store_true')
    args=parser.parse_args()
    try:
        if args.command=='profile':
            print((ROOT/'profiles'/f'{args.network}.json').read_text());return 0
        command=prepare(args)
        os.execv(command[0],command)
    except (ValueError,KeyError,OSError) as error:
        # Never echo RPC response bodies, keystore contents, or credential paths.
        print('Release preflight refused. '+(str(error) if isinstance(error,ValueError) else 'Check local release files and RPC connectivity.'),file=sys.stderr)
        return 2
if __name__=='__main__': sys.exit(main())
